{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "declaration": false,
    "declarationMap": false,
    "incremental": true,
    "strictPropertyInitialization": false
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
