    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.1",
    "typescript": "~5.8.3"
