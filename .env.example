# Copy to .env for local development. Never commit real secrets.

NODE_ENV=development
APP_NAME=hasut-api
APP_VERSION=0.0.0
PORT=3001
API_PREFIX=api/v1
LOG_LEVEL=info

# PostgreSQL + PostGIS (docker compose service "postgres")
DATABASE_URL=postgresql://hasut:hasut@localhost:5432/hasut?schema=public

# Redis (docker compose service "redis")
REDIS_URL=redis://localhost:6379

# CORS allowlist (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Optional. When empty, Sentry is disabled (local default).
SENTRY_DSN=

# Object storage (MinIO in docker compose). Use MEDIA_STORAGE=s3 to persist uploads.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=hasut-media
S3_ACCESS_KEY=hasut
S3_SECRET_KEY=hasutsecret
S3_FORCE_PATH_STYLE=true
MEDIA_STORAGE=memory
GEOCODER_PROVIDER=console

# Auth (console OTP is local/dev only; production must use msg91)
OTP_PROVIDER=console
JWT_ACCESS_SECRET=hasut-dev-access-secret-32chars-min
JWT_REFRESH_SECRET=hasut-dev-refresh-secret-32chars-min
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Email OTP delivery (console is local/dev only; production must use smtp).
EMAIL_PROVIDER=console
EMAIL_FROM=HASUT <no-reply@hasut.local>
SMTP_URL=

# Sign-in captcha (none is local/dev only; production must use recaptcha).
# The site key is published to clients through GET /api/v1/auth/config.
CAPTCHA_PROVIDER=none
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# SSO. Leave empty to hide the provider button on the sign-in screens.
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Browser REST uses the Next `/api` rewrite. This is the rewrite/WebSocket target.
# Prefer 127.0.0.1 on Windows so Node does not hit IPv6 localhost.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
EXPO_PUBLIC_API_URL=http://localhost:3001

# Optional. Seed grants ADMIN to this phone so the admin console can sign in.
# 10-digit Indian mobiles are accepted (7010358490 → +917010358490).
ADMIN_BOOTSTRAP_PHONE=+917010358490
# Console OTP only. Empty in production. After "Send code", enter this value.
DEV_OTP_CODE=123456

# Optional discovery basemap keys. Empty skips MapTiler; Stadia still works without a key.
MAPTILER_API_KEY=
STADIA_API_KEY=

# Optional HLS origin for Phase 2 live/story previews (MediaMTX / CDN). Empty uses /media/hls, rewritten by the web app and proxied by the API to http://127.0.0.1:8888.
LIVE_HLS_BASE_URL=
# WHIP ingest is a different port from HLS. Empty uses /media/whip, rewritten by the web app to http://127.0.0.1:8889.
LIVE_WHIP_BASE_URL=
# Optional ffmpeg binary for story HLS. Empty leaves new videos PENDING. Example: ffmpeg
FFMPEG_PATH=
